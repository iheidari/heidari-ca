---
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.jpg";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import MailIcon from "@/components/icons/MailIcon.astro";
import PostList from "@/components/PostList.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SmartLink from "@/components/SmartLink.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { posts } from "@/content/posts";
import { projects } from "@/content/projects";
import { site } from "@/content/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import styles from "@/styles/home.module.css";

const latestPosts = posts.slice(0, 3);
const { work, writing, contact } = site.sections;
---

<BaseLayout>
  <div class={styles.main}>
    <section class={styles.hero} aria-labelledby="hero-title">
      <div class={styles.heroText}>
        {
          site.available ? (
            <p class={styles.badge}>
              <span class={styles.dot} aria-hidden="true" />
              Available for new work
            </p>
          ) : null
        }

        <h1 id="hero-title" class={styles.heroTitle}>
          {site.tagline}
        </h1>

        <p class={styles.heroIntro}>{site.intro}</p>

        <div class={styles.actions}>
          <a class={styles.primaryAction} href="#work">
            See my work
            <ArrowRightIcon width={18} height={18} />
          </a>
          <SmartLink class={styles.secondaryAction} href={site.mailto}>
            <MailIcon width={18} height={18} />
            Get in touch
          </SmartLink>
        </div>

        <SocialLinks />
      </div>

      <div class={styles.heroCard}>
        <Image
          class={styles.avatar}
          src={avatar}
          alt={`Portrait of ${site.name}`}
          width={112}
          height={112}
          densities={[1, 2]}
          priority
        />
        <p class={styles.heroName}>{site.name}</p>
        <p class={styles.heroRole}>
          {site.role} · {site.location}
        </p>
        <ul class={styles.stack} role="list">
          {site.stack.map((item) => <li class={styles.stackItem}>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="work" class={styles.section} aria-labelledby="work-title">
      <header class={styles.sectionHead}>
        <h2 id="work-title" class={styles.sectionTitle}>
          {work.title}
        </h2>
        <p class={styles.sectionLead}>{work.lead}</p>
      </header>

      <div class={styles.projectGrid}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    {
      latestPosts.length > 0 ? (
        <section
          id="writing"
          class={styles.section}
          aria-labelledby="writing-title"
        >
          <header class={styles.sectionHead}>
            <h2 id="writing-title" class={styles.sectionTitle}>
              {writing.title}
            </h2>
            <p class={styles.sectionLead}>{writing.lead}</p>
          </header>

          <PostList posts={latestPosts} />

          <a class={styles.moreLink} href="/blog">
            All posts
            <ArrowRightIcon width={18} height={18} />
          </a>
        </section>
      ) : null
    }

    <section
      id="contact"
      class={styles.contact}
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title" class={styles.contactTitle}>
        {contact.title}
      </h2>
      <p class={styles.contactLead}>{contact.lead}</p>
      <div class={styles.actions}>
        <SmartLink class={styles.primaryAction} href={site.mailto}>
          <MailIcon width={18} height={18} />
          {site.email}
        </SmartLink>
        <SmartLink class={styles.secondaryAction} href={site.socials.linkedin}>
          Connect on LinkedIn
        </SmartLink>
      </div>
    </section>
  </div>
</BaseLayout>
