{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heidari-ca",
  "compatibility_date": "2026-10-15",
  // Apex only, matching `site` in astro.config.mjs; www redirects here via a
  // Cloudflare Redirect Rule.
  "routes": [{ "pattern": "heidari.ca", "custom_domain": true }],
  // Static-only Worker: no script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    // Matches Astro's `trailingSlash: "never"` + `build.format: "file"`:
    // /blog serves blog.html, and /blog/ or /blog.html redirect to /blog.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
